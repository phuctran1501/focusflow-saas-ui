@model FocusFlow.ViewModels.FocusViewModel
@{
    ViewData["Title"] = "Focus Room";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/focus.css" asp-append-version="true" />
}

<div class="focus-room-container" id="focusRoomContainer">
    <!-- Top Bar -->
    <div class="focus-room-topbar">
        <div class="focus-session-meta">
            <span class="focus-session-badge">Deep Flow Space</span>
            <span class="focus-session-title" id="activeTaskHeading">Current Goal: @Model.CurrentTaskTitle</span>
        </div>

        <div class="focus-room-actions">
            <button type="button" class="focus-glass-btn" id="ambientToggleBtn" title="Ambient Soundscape">
                <span id="soundStatusIcon">🌧️</span>
                <span id="soundStatusText">Gentle Rain</span>
            </button>
            <button type="button" class="focus-glass-btn" id="fullscreenBtn" title="Distraction-Free Mode">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="fullscreenIcon">
                    <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                </svg>
                <span id="fullscreenText">Full View</span>
            </button>
        </div>
    </div>

    <!-- 3-Column Focus Grid -->
    <div class="focus-grid">
        <!-- 1. Centerpiece: Circular Timer -->
        <div class="glass-panel timer-hero-panel">
            <!-- Mode Switcher -->
            <div class="timer-mode-pills">
                <button type="button" class="timer-mode-btn active" data-minutes="25" data-mode="Focus">Focus 25m</button>
                <button type="button" class="timer-mode-btn" data-minutes="5" data-mode="Short Break">Short Break</button>
                <button type="button" class="timer-mode-btn" data-minutes="15" data-mode="Long Break">Long Break</button>
            </div>

            <!-- Big Circular Countdown -->
            <div class="timer-dial-wrapper">
                <svg class="timer-svg-ring" viewBox="0 0 260 260">
                    <circle class="ring-bg" cx="130" cy="130" r="120" />
                    <circle class="ring-progress" id="ringProgress" cx="130" cy="130" r="120" />
                </svg>
                <div class="timer-center-text">
                    <div class="timer-digits-wrapper" id="timerDigitsWrapper" title="Click to edit duration">
                        <div class="timer-digits" id="timerDigits">25:00</div>
                        <span class="timer-edit-badge">✎ Edit</span>
                    </div>
                    <div class="timer-status-hint" id="timerModeHint">Focus Session</div>
                </div>
            </div>

            <!-- Quick Adjust Controls -->
            <div class="timer-adjust-controls">
                <button type="button" class="btn-time-adjust" id="btnMinus5m" title="Subtract 5 minutes">-5m</button>
                <button type="button" class="btn-time-adjust" id="btnCustomTime" title="Custom duration">✎ Custom</button>
                <button type="button" class="btn-time-adjust" id="btnPlus5m" title="Add 5 minutes">+5m</button>
            </div>

            <!-- Timer Action Buttons -->
            <div class="timer-control-row">
                <button type="button" class="btn-focus-sub" id="timerResetBtn" title="Reset Session">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                </button>

                <button type="button" class="btn-focus-main" id="timerMainPlayBtn" title="Start Session">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" id="playIconSvg">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                </button>

                <button type="button" class="btn-focus-sub" id="timerSkipBtn" title="Complete & Skip">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 4 15 12 5 20 5 4"></polygon>
                        <line x1="19" y1="5" x2="19" y2="19"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- 2. Tasks Column with Drag-and-Drop & Delete -->
        <div class="glass-panel">
            <div class="glass-panel-title">
                <span>Session Tasks</span>
                <span style="font-size: 0.78rem; color: #94A3B8;">Drag to reorder</span>
            </div>

            <div class="focus-task-add-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <input type="text" id="focusNewTaskInput" class="focus-task-input" placeholder="Add a new task and press Enter..." />
            </div>

            <div class="focus-tasks-stack" id="focusTasksContainer">
                @for (int i = 0; i < Model.FocusTasks.Count; i++)
                {
                    var task = Model.FocusTasks[i];
                    <div class="focus-task-item @(i == 0 ? "active-focus-task" : "") @(task.IsCompleted ? "completed" : "")" 
                         data-title="@task.Title" 
                         draggable="true">
                        <div class="focus-task-drag-handle" title="Drag to reorder">⠿</div>
                        <label class="flow-checkbox-wrapper">
                            <input type="checkbox" class="flow-checkbox-input focus-task-check" @(task.IsCompleted ? "checked" : "") />
                            <span class="flow-checkbox-mark"></span>
                        </label>
                        <span class="focus-task-text">@task.Title</span>
                        <button type="button" class="btn-focus-task-delete" title="Delete task">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- 3. Day Structure & Ambient Sound -->
        <div class="glass-panel">
            <div class="glass-panel-title">
                <span>Day Structure</span>
                <span style="font-size: 0.78rem; color: #94A3B8;">Presets</span>
            </div>

            <div class="day-structure-stack">
                @foreach (var s in Model.DayStructures)
                {
                    <div class="day-structure-card @(s.IsActive ? "active" : "")" data-title="@s.Title">
                        <div class="structure-icon-box" style="background: @s.IconColor;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                <path d="M9 12h6m-6-4h6m-6 8h4"></path>
                            </svg>
                        </div>
                        <div style="flex: 1;">
                            <div class="structure-title-row">
                                <span class="structure-title">@s.Title</span>
                                <span class="structure-badge">@s.Badge</span>
                            </div>
                            <div class="structure-desc">@s.Description</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Distinct Ambient Soundscapes -->
            <div class="soundscape-section">
                <div style="font-size: 0.82rem; font-weight: 700; color: #E2E8F0; margin-bottom: 10px;">Focus Ambient Soundscape</div>
                <div class="sound-presets-row">
                    @foreach (var sound in Model.AmbientSounds)
                    {
                        <div class="sound-chip @(sound.IsActive ? "active" : "")" data-sound="@sound.Id" data-name="@sound.Name" data-icon="@sound.Icon">
                            <span style="font-size: 1.1rem;">@sound.Icon</span>
                            <span>@sound.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ==========================================================================
        // 1. Circular Timer with Custom Editable Duration
        // ==========================================================================
        let totalSeconds = 25 * 60;
        let remainingSeconds = totalSeconds;
        let timerRunning = false;
        let timerInterval = null;

        const timerDigits = document.getElementById('timerDigits');
        const timerModeHint = document.getElementById('timerModeHint');
        const playBtn = document.getElementById('timerMainPlayBtn');
        const resetBtn = document.getElementById('timerResetBtn');
        const skipBtn = document.getElementById('timerSkipBtn');
        const ringProgress = document.getElementById('ringProgress');
        const circumference = 2 * Math.PI * 120; // 753.98

        ringProgress.style.strokeDasharray = circumference;

        function updateDisplay() {
            const m = Math.floor(remainingSeconds / 60).toString().padStart(2, '0');
            const s = (remainingSeconds % 60).toString().padStart(2, '0');
            timerDigits.textContent = `${m}:${s}`;

            const offset = circumference - (remainingSeconds / totalSeconds) * circumference;
            ringProgress.style.strokeDashoffset = offset;
        }

        function setDurationMinutes(mins) {
            mins = Math.max(1, Math.min(180, parseInt(mins) || 25));
            totalSeconds = mins * 60;
            remainingSeconds = totalSeconds;
            if (timerRunning) {
                toggleTimer(); // pause
            }
            updateDisplay();
        }

        // Custom time adjustment: Click digits or Custom button
        function promptCustomTime() {
            const currentMins = Math.round(totalSeconds / 60);
            const userMins = prompt("Enter custom focus duration (in minutes, 1-180):", currentMins);
            if (userMins !== null && !isNaN(parseInt(userMins))) {
                setDurationMinutes(parseInt(userMins));
                document.querySelectorAll('.timer-mode-btn').forEach(b => b.classList.remove('active'));
                timerModeHint.textContent = `Custom (${userMins}m)`;
            }
        }

        document.getElementById('timerDigitsWrapper').addEventListener('click', promptCustomTime);
        document.getElementById('btnCustomTime').addEventListener('click', promptCustomTime);

        document.getElementById('btnPlus5m').addEventListener('click', () => {
            const currentMins = Math.round(totalSeconds / 60);
            setDurationMinutes(currentMins + 5);
        });

        document.getElementById('btnMinus5m').addEventListener('click', () => {
            const currentMins = Math.round(totalSeconds / 60);
            setDurationMinutes(Math.max(1, currentMins - 5));
        });

        function toggleTimer() {
            timerRunning = !timerRunning;
            if (timerRunning) {
                playBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>`;
                timerInterval = setInterval(() => {
                    if (remainingSeconds > 0) {
                        remainingSeconds--;
                        updateDisplay();
                    } else {
                        clearInterval(timerInterval);
                        timerRunning = false;
                        playBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
                        alert('Focus session complete! Great job maintaining flow.');
                    }
                }, 1000);
            } else {
                clearInterval(timerInterval);
                playBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
            }
        }

        playBtn.addEventListener('click', toggleTimer);

        resetBtn.addEventListener('click', () => {
            clearInterval(timerInterval);
            timerRunning = false;
            remainingSeconds = totalSeconds;
            updateDisplay();
            playBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
        });

        skipBtn.addEventListener('click', () => {
            clearInterval(timerInterval);
            timerRunning = false;
            remainingSeconds = 0;
            updateDisplay();
            playBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
        });

        // Mode Switcher (Focus, Short Break, Long Break)
        document.querySelectorAll('.timer-mode-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.timer-mode-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const mins = parseInt(this.dataset.minutes);
                const mode = this.dataset.mode;
                timerModeHint.textContent = mode;
                setDurationMinutes(mins);
            });
        });

        // Day Structure Click
        document.querySelectorAll('.day-structure-card').forEach(card => {
            card.addEventListener('click', function () {
                document.querySelectorAll('.day-structure-card').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                const title = this.dataset.title;
                if (title === 'Deep Work') {
                    setDurationMinutes(50);
                    timerModeHint.textContent = "Deep Work Block (50m)";
                } else if (title === 'Study Mode') {
                    setDurationMinutes(45);
                    timerModeHint.textContent = "Study Mode (45m)";
                } else {
                    setDurationMinutes(25);
                    timerModeHint.textContent = "Power Sprint (25m)";
                }
            });
        });

        // ==========================================================================
        // 2. Full View (Distraction-Free Mode)
        // ==========================================================================
        const fullscreenBtn = document.getElementById('fullscreenBtn');
        const focusRoomContainer = document.getElementById('focusRoomContainer');
        const fullscreenText = document.getElementById('fullscreenText');

        if (fullscreenBtn) {
            fullscreenBtn.addEventListener('click', function () {
                const isCurrentlyActive = focusRoomContainer.classList.contains('fullscreen-active');
                if (!isCurrentlyActive) {
                    focusRoomContainer.classList.add('fullscreen-active');
                    fullscreenText.textContent = "Exit Full View";
                    if (document.documentElement.requestFullscreen && !document.fullscreenElement) {
                        document.documentElement.requestFullscreen().catch(() => {});
                    }
                } else {
                    focusRoomContainer.classList.remove('fullscreen-active');
                    fullscreenText.textContent = "Full View";
                    if (document.exitFullscreen && document.fullscreenElement) {
                        document.exitFullscreen().catch(() => {});
                    }
                }
            });
        }

        // ==========================================================================
        // 3. Drag & Drop Task Reordering + Delete Tasks
        // ==========================================================================
        const activeTaskHeading = document.getElementById('activeTaskHeading');
        const tasksContainer = document.getElementById('focusTasksContainer');

        function bindTaskEvents() {
            document.querySelectorAll('.focus-task-item').forEach(item => {
                // Select active task
                item.addEventListener('click', function (e) {
                    if (e.target.type === 'checkbox' || e.target.closest('.btn-focus-task-delete')) return;
                    document.querySelectorAll('.focus-task-item').forEach(i => i.classList.remove('active-focus-task'));
                    this.classList.add('active-focus-task');
                    activeTaskHeading.textContent = 'Current Goal: ' + this.dataset.title;
                });

                // Delete Task button
                const delBtn = item.querySelector('.btn-focus-task-delete');
                if (delBtn) {
                    delBtn.onclick = function (e) {
                        e.stopPropagation();
                        item.style.transition = 'all 0.25s ease';
                        item.style.opacity = '0';
                        item.style.transform = 'translateX(20px)';
                        setTimeout(() => item.remove(), 250);
                    };
                }

                // Drag & Drop
                item.addEventListener('dragstart', function (e) {
                    this.classList.add('is-dragging');
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', this.dataset.title);
                });

                item.addEventListener('dragend', function () {
                    this.classList.remove('is-dragging');
                    document.querySelectorAll('.focus-task-item').forEach(i => i.classList.remove('drag-over'));
                });

                item.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    this.classList.add('drag-over');
                });

                item.addEventListener('dragleave', function () {
                    this.classList.remove('drag-over');
                });

                item.addEventListener('drop', function (e) {
                    e.preventDefault();
                    this.classList.remove('drag-over');
                    const draggingItem = document.querySelector('.focus-task-item.is-dragging');
                    if (draggingItem && draggingItem !== this) {
                        tasksContainer.insertBefore(draggingItem, this);
                    }
                });
            });

            // Checkbox toggle
            document.querySelectorAll('.focus-task-check').forEach(chk => {
                chk.onchange = function () {
                    const parent = this.closest('.focus-task-item');
                    if (parent) {
                        if (this.checked) parent.classList.add('completed');
                        else parent.classList.remove('completed');
                    }
                };
            });
        }

        bindTaskEvents();

        // Add New Task Input
        const newTaskInput = document.getElementById('focusNewTaskInput');
        if (newTaskInput) {
            newTaskInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && this.value.trim() !== '') {
                    const text = this.value.trim();
                    const newDiv = document.createElement('div');
                    newDiv.className = 'focus-task-item active-focus-task';
                    newDiv.dataset.title = text;
                    newDiv.draggable = true;
                    newDiv.innerHTML = `
                        <div class="focus-task-drag-handle" title="Drag to reorder">⠿</div>
                        <label class="flow-checkbox-wrapper">
                            <input type="checkbox" class="flow-checkbox-input focus-task-check" />
                            <span class="flow-checkbox-mark"></span>
                        </label>
                        <span class="focus-task-text">${text}</span>
                        <button type="button" class="btn-focus-task-delete" title="Delete task">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    `;
                    document.querySelectorAll('.focus-task-item').forEach(i => i.classList.remove('active-focus-task'));
                    tasksContainer.prepend(newDiv);
                    activeTaskHeading.textContent = 'Current Goal: ' + text;
                    this.value = '';
                    bindTaskEvents();
                }
            });
        }

        // ==========================================================================
        // 4. Distinct Procedural Ambient Soundscapes (Web Audio API)
        // ==========================================================================
        let audioCtx = null;
        let activeSoundNodes = [];
        let currentSoundId = 'rain';
        let isAudioPlaying = false;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function stopCurrentAudio() {
            activeSoundNodes.forEach(node => {
                try {
                    if (node.stop) node.stop();
                    if (node.disconnect) node.disconnect();
                } catch (e) {}
            });
            activeSoundNodes = [];
            isAudioPlaying = false;
        }

        // 1. Rain Synthesizer (Pink Noise + Lowpass + Droplet Flutter)
        function playRain() {
            const ctx = getAudioContext();
            const bufferSize = ctx.sampleRate * 2;
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            let lastOut = 0.0;

            for (let i = 0; i < bufferSize; i++) {
                const white = Math.random() * 2 - 1;
                data[i] = (lastOut + (0.02 * white)) / 1.02;
                lastOut = data[i];
                data[i] *= 0.16;
            }

            const noise = ctx.createBufferSource();
            noise.buffer = buffer;
            noise.loop = true;

            const filter = ctx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.value = 750;

            noise.connect(filter);
            filter.connect(ctx.destination);
            noise.start(0);

            activeSoundNodes.push(noise, filter);
            isAudioPlaying = true;
        }

        // 2. Alpha Waves Synthesizer (Binaural Beats: 196Hz + 206Hz = 10Hz Alpha pulse)
        function playAlphaWaves() {
            const ctx = getAudioContext();

            // Left Ear
            const oscL = ctx.createOscillator();
            oscL.type = 'sine';
            oscL.frequency.value = 196; // G3

            // Right Ear
            const oscR = ctx.createOscillator();
            oscR.type = 'sine';
            oscR.frequency.value = 206; // 10Hz delta for Alpha state

            const gain = ctx.createGain();
            gain.gain.value = 0.06;

            const filter = ctx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.value = 350;

            oscL.connect(filter);
            oscR.connect(filter);
            filter.connect(gain);
            gain.connect(ctx.destination);

            oscL.start();
            oscR.start();

            activeSoundNodes.push(oscL, oscR, filter, gain);
            isAudioPlaying = true;
        }

        // 3. Pine Forest Synthesizer (Sweeping Wind Noise + Periodic Chime Blips)
        function playPineForest() {
            const ctx = getAudioContext();
            const bufferSize = ctx.sampleRate * 3;
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            let b0 = 0, b1 = 0, b2 = 0;

            for (let i = 0; i < bufferSize; i++) {
                const white = Math.random() * 2 - 1;
                b0 = 0.99 * b0 + white * 0.05;
                b1 = 0.95 * b1 + white * 0.04;
                b2 = 0.85 * b2 + white * 0.02;
                data[i] = (b0 + b1 + b2) * 0.06;
            }

            const wind = ctx.createBufferSource();
            wind.buffer = buffer;
            wind.loop = true;

            const filter = ctx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.value = 400;
            filter.Q.value = 1.2;

            // Slow wind swell LFO
            const lfo = ctx.createOscillator();
            lfo.frequency.value = 0.15;
            const lfoGain = ctx.createGain();
            lfoGain.gain.value = 180;
            lfo.connect(lfoGain);
            lfoGain.connect(filter.frequency);

            wind.connect(filter);
            filter.connect(ctx.destination);

            lfo.start();
            wind.start();

            activeSoundNodes.push(wind, filter, lfo, lfoGain);
            isAudioPlaying = true;
        }

        // 4. Cozy Cafe Synthesizer (Warm Brown Murmur + Gentle Resonant Clinks)
        function playCozyCafe() {
            const ctx = getAudioContext();
            const bufferSize = ctx.sampleRate * 2;
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            let lastOut = 0.0;

            for (let i = 0; i < bufferSize; i++) {
                const white = Math.random() * 2 - 1;
                data[i] = (lastOut + (0.015 * white)) / 1.015;
                lastOut = data[i];
                data[i] *= 0.18;
            }

            const murmur = ctx.createBufferSource();
            murmur.buffer = buffer;
            murmur.loop = true;

            const filter = ctx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.value = 320; // warm chatter rumble

            murmur.connect(filter);
            filter.connect(ctx.destination);
            murmur.start();

            activeSoundNodes.push(murmur, filter);
            isAudioPlaying = true;
        }

        function playSelectedSound(soundId) {
            stopCurrentAudio();
            currentSoundId = soundId;

            if (soundId === 'rain') playRain();
            else if (soundId === 'waves') playAlphaWaves();
            else if (soundId === 'forest') playPineForest();
            else if (soundId === 'cafe') playCozyCafe();

            const toggleBtn = document.getElementById('ambientToggleBtn');
            if (toggleBtn) toggleBtn.classList.add('active');
        }

        const ambientToggleBtn = document.getElementById('ambientToggleBtn');
        if (ambientToggleBtn) {
            ambientToggleBtn.addEventListener('click', function () {
                if (!isAudioPlaying) {
                    playSelectedSound(currentSoundId);
                } else {
                    stopCurrentAudio();
                    this.classList.remove('active');
                }
            });
        }

        // Sound Chip Click
        document.querySelectorAll('.sound-chip').forEach(chip => {
            chip.addEventListener('click', function () {
                document.querySelectorAll('.sound-chip').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('soundStatusIcon').textContent = this.dataset.icon;
                document.getElementById('soundStatusText').textContent = this.dataset.name;
                playSelectedSound(this.dataset.sound);
            });
        });

        // Initialize display
        updateDisplay();
    </script>
}
