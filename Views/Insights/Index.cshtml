@model FocusFlow.ViewModels.InsightsViewModel
@{
    ViewData["Title"] = "Productivity Insights";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/insights.css" asp-append-version="true" />
}

<!-- Insights Header Bar (Matching Screenshot 4) -->
<div class="insights-header">
    <div>
        <h1 class="insights-title">Productivity Insights</h1>
        <p class="insights-subtitle">Your weekly performance breakdown and focus trends.</p>
    </div>

    <div class="insights-controls">
        <div class="pill-tab-group" id="insightsTimeframeTabs">
            <button type="button" class="pill-tab">Day</button>
            <button type="button" class="pill-tab active">Week</button>
            <button type="button" class="pill-tab">Month</button>
        </div>

        <button type="button" class="btn-flow btn-flow-primary" id="downloadReportBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download Report</span>
        </button>
    </div>
</div>

<!-- 1. Hero Analytics Card (Smooth Wave Spline Chart) -->
<div class="insights-hero-card">
    <div class="insights-hero-top">
        <div>
            <div class="score-meta-label">Weekly Productivity Score</div>
            <div class="score-value-row">
                <span class="score-huge-text" id="displayScore">@Model.ProductivityScore%</span>
                <span class="flow-trend-pill positive">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="18 15 12 9 6 15"></polyline>
                    </svg>
                    <span>@Model.ScoreTrend</span>
                </span>
            </div>
        </div>

        <div class="chart-legend-wrap">
            <div class="legend-item">
                <span class="legend-dot-current"></span>
                <span>Current Week</span>
            </div>
            <div class="legend-item">
                <span class="legend-dot-prev"></span>
                <span>Previous Week</span>
            </div>
        </div>
    </div>

    <!-- Smooth Wave SVG Chart -->
    <div class="wave-chart-wrapper">
        <svg class="wave-svg" viewBox="0 0 1000 200" preserveAspectRatio="none">
            <defs>
                <linearGradient id="waveGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#635BFF" stop-opacity="0.32" />
                    <stop offset="100%" stop-color="#635BFF" stop-opacity="0.0" />
                </linearGradient>
            </defs>

            <!-- Subtle Previous Week Reference Wave (Dashed) -->
            <path d="M 0 140 C 160 160, 320 120, 500 130 C 680 140, 840 100, 1000 120"
                  fill="none" stroke="#E2E8F0" stroke-width="3" stroke-dasharray="6 6" />

            <!-- Gradient Area Fill Under Wave -->
            <path d="M 0 120 C 150 110, 280 60, 420 50 C 560 40, 680 130, 820 110 C 910 95, 960 70, 1000 65 L 1000 200 L 0 200 Z"
                  fill="url(#waveGradient)" />

            <!-- Main Current Week Smooth Spline Wave -->
            <path d="M 0 120 C 150 110, 280 60, 420 50 C 560 40, 680 130, 820 110 C 910 95, 960 70, 1000 65"
                  fill="none" stroke="#635BFF" stroke-width="4.5" stroke-linecap="round" />

            <!-- Highlight Interactive Data Points -->
            <circle cx="0" cy="120" r="5" fill="#fff" stroke="#635BFF" stroke-width="3" />
            <circle cx="166" cy="98" r="5" fill="#fff" stroke="#635BFF" stroke-width="3" />
            <circle cx="333" cy="55" r="5" fill="#fff" stroke="#635BFF" stroke-width="3" />
            <circle cx="500" cy="46" r="6" fill="#635BFF" stroke="#fff" stroke-width="3" />
            <circle cx="666" cy="126" r="5" fill="#fff" stroke="#635BFF" stroke-width="3" />
            <circle cx="833" cy="108" r="5" fill="#fff" stroke="#635BFF" stroke-width="3" />
            <circle cx="1000" cy="65" r="5" fill="#fff" stroke="#635BFF" stroke-width="3" />
        </svg>

        <div class="chart-days-row">
            <span class="chart-day-label">MON</span>
            <span class="chart-day-label">TUE</span>
            <span class="chart-day-label">WED</span>
            <span class="chart-day-label">THU</span>
            <span class="chart-day-label">FRI</span>
            <span class="chart-day-label">SAT</span>
            <span class="chart-day-label">SUN</span>
        </div>
    </div>
</div>

<!-- 2. Middle Row: Streak Card + Completion Donut (Matching Screenshot 4) -->
<div class="insights-middle-grid">
    <!-- Current Streak Card -->
    <div class="streak-card">
        <div>
            <div class="streak-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                </svg>
            </div>
            <div class="streak-card-label">Current Streak</div>
            <div class="streak-days-number">@Model.StreakDays Days</div>
        </div>

        <div class="streak-community-row">
            <div class="avatar-stack">
                <div class="stack-avatar" style="background: #3B82F6;">RK</div>
                <div class="stack-avatar" style="background: #8B5CF6;">SB</div>
                <div class="stack-avatar" style="background: #10B981;">AM</div>
                <div class="stack-avatar stack-badge-count">+8</div>
            </div>
            <div class="streak-ranking-text">
                You're in the top <strong>@Model.TopPercentile%</strong> this week!
            </div>
        </div>
    </div>

    <!-- Task Completion Donut Card -->
    <div class="completion-card">
        <div class="completion-info-side">
            <div class="completion-card-label">Task Completion</div>
            <div class="completion-percentage-text">@Model.CompletionRate% Complete</div>

            <div class="completion-stats-list">
                <div class="completion-stat-item">
                    <span class="dot-completed"></span>
                    <span>Completed: <strong>@Model.CompletedTasksCount</strong></span>
                </div>
                <div class="completion-stat-item">
                    <span class="dot-pending"></span>
                    <span>Pending: <strong>@Model.PendingTasksCount</strong></span>
                </div>
            </div>
        </div>

        <!-- Donut Ring Chart -->
        <div class="donut-chart-box">
            <svg class="donut-svg" viewBox="0 0 100 100">
                <circle class="donut-bg" cx="50" cy="50" r="40" />
                <circle class="donut-val" cx="50" cy="50" r="40" />
            </svg>
            <div class="donut-center-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- 3. Bottom Row: 3 Highlight Insight Cards (Matching Screenshot 4) -->
<div class="insights-bottom-grid">
    @foreach (var card in Model.Insights)
    {
        <div class="highlight-insight-card">
            <div class="insight-icon-square" style="background: @card.IconBg; color: @card.IconColor;">
                @if (card.IconType == "lightning")
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                }
                else if (card.IconType == "trending")
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                }
                else
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                }
            </div>
            <div class="insight-card-content">
                <div class="insight-card-heading">@card.Title</div>
                <div class="insight-card-body-text">@card.Description</div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Timeframe selector simulation
        document.querySelectorAll('#insightsTimeframeTabs .pill-tab').forEach(tab => {
            tab.addEventListener('click', function () {
                document.querySelectorAll('#insightsTimeframeTabs .pill-tab').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                const text = this.textContent.trim();
                const scoreElem = document.getElementById('displayScore');
                if (text === 'Day') {
                    scoreElem.textContent = '91.4%';
                } else if (text === 'Week') {
                    scoreElem.textContent = '84.2%';
                } else {
                    scoreElem.textContent = '87.8%';
                }
            });
        });

        // Download Report Simulation
        const downloadBtn = document.getElementById('downloadReportBtn');
        if (downloadBtn) {
            downloadBtn.addEventListener('click', () => {
                alert('FocusFlow Report (CSV/PDF) generated successfully! Check your downloads.');
            });
        }
    </script>
}
