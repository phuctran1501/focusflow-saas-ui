<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FocusFlow SaaS</title>
    <meta name="description" content="FocusFlow - Modern productivity and focus-tracking SaaS dashboard. Plan your day, track deep work sessions, and conquer your goals." />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <!-- Design System & Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <!-- Mobile Sidebar Backdrop -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Reusable Sidebar -->
        <partial name="_Sidebar" />

        <!-- Main Workspace -->
        <div class="app-main">
            <!-- Top App Header -->
            <header class="top-header" id="topHeader">
                <div class="header-left">
                    <button type="button" class="menu-toggle-btn" id="mobileMenuBtn" aria-label="Toggle Navigation">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    
                    <div class="header-search">
                        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="globalSearchInput" class="search-input" placeholder="Search tasks, sessions or type a command..." />
                        <span class="search-shortcut">⌘ F</span>
                    </div>
                </div>

                <div class="header-right">
                    <div class="header-date-pill">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span id="currentDateDisplay">Wednesday, Nov 26</span>
                    </div>

                    <a asp-controller="Focus" asp-action="Index" class="btn-flow btn-flow-secondary btn-flow-sm" title="Quick Focus Session">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <span>Focus</span>
                    </a>

                    <button type="button" class="header-action-btn" id="notifBellBtn" title="Notifications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span class="notif-badge-dot"></span>
                    </button>
                </div>
            </header>

            <!-- Page Body Content -->
            <main class="content-body" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
