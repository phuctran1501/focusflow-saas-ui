@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

<aside class="app-sidebar" id="appSidebar">
    <!-- Brand / Logo -->
    <div class="sidebar-header">
        <a asp-controller="Home" asp-action="Index" class="brand-logo">
            <div class="brand-icon-box" style="background: transparent; box-shadow: none; width: 32px; height: 32px;">
                <svg width="32" height="32" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M 28 28 Q 50 42 72 72" stroke="#1E2238" stroke-width="15"/>
                        <path d="M 72 28 Q 50 42 28 72" stroke="#1E2238" stroke-width="15"/>
                        <path d="M 28 28 Q 42 50 50 50" stroke="#FF6B00" stroke-width="15"/>
                    </g>
                    <circle cx="28" cy="28" r="13" fill="#FF6B00"/>
                    <circle cx="72" cy="28" r="13" fill="#1E2238"/>
                    <circle cx="28" cy="72" r="13" fill="#1E2238"/>
                    <circle cx="72" cy="72" r="13" fill="#1E2238"/>
                </svg>
            </div>
            <span class="brand-name">FocusFlow</span>
            <span class="brand-badge">SaaS</span>
        </a>
    </div>

    <!-- Navigation List -->
    <div class="sidebar-content">
        <!-- Main Navigation Section -->
        <div>
            <div class="nav-group-title">Main</div>
            <ul class="sidebar-nav-list">
                <li class="sidebar-nav-item">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-nav-link @(currentController == "Home" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="3" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/>
                            <rect x="14" y="3" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/>
                            <rect x="14" y="14" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/>
                            <rect x="3" y="14" width="7" height="7" rx="2" stroke="currentColor" stroke-width="2"/>
                        </svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Focus" asp-action="Index" class="sidebar-nav-link @(currentController == "Focus" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
                            <path d="M12 7V12L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span>Focus Room</span>
                        <span class="nav-badge-pill">Live</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Tasks" asp-action="Index" class="sidebar-nav-link @(currentController == "Tasks" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 11L12 14L22 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M21 12V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V5C3 3.89543 3.89543 3 5 3H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span>My Tasks</span>
                        <span class="nav-badge-pill">12</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Insights" asp-action="Index" class="sidebar-nav-link @(currentController == "Insights" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 20V10M12 20V4M6 20V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>Insights</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Tools Section -->
        <div>
            <div class="nav-group-title">Tools</div>
            <ul class="sidebar-nav-list">
                <li class="sidebar-nav-item">
                    <a asp-controller="Focus" asp-action="Index" class="sidebar-nav-link">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
                            <path d="M12 6V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M16 12H12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <span>Time Tracker</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Insights" asp-action="Index" class="sidebar-nav-link">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3V21H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M7 14L12 9L16 13L21 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>Analytics</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- User Profile Footer -->
    <div class="sidebar-footer">
        <div class="user-profile-widget">
            <div class="user-avatar-wrapper">
                <div class="user-avatar">AM</div>
                <div class="user-status-online" title="Online & Focused"></div>
            </div>
            <div class="user-meta">
                <div class="user-name">Alex Morgan</div>
                <div class="user-role">Productivity Pro</div>
            </div>
            <button type="button" class="btn-flow-ghost btn-flow-icon" title="Account settings">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="1"></circle>
                    <circle cx="12" cy="5" r="1"></circle>
                    <circle cx="12" cy="19" r="1"></circle>
                </svg>
            </button>
        </div>
    </div>
</aside>
