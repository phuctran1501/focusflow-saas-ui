---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard Overview" activePage="dashboard" pageCss="/css/pages/dashboard.css">
  <!-- Hero Greeting Section -->
  <div class="dashboard-hero">
    <div>
      <h1 class="greeting-title">Hello, Phúc Trần! 👋</h1>
      <p class="greeting-subtitle">Welcome to your personal deep work and productivity space.</p>
    </div>
    <div class="hero-actions">
      <a href="/tasks" class="btn-flow btn-flow-secondary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Add Task</span>
      </a>
      <a href="/focus" class="btn-flow btn-flow-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>Start Focus Session</span>
      </a>
    </div>
  </div>

  <!-- KPI Cards: Zero baseline, no fake mock data -->
  <div class="kpi-grid">
    <!-- Projects -->
    <div class="flow-card kpi-card flow-card-interactive">
      <div class="kpi-header">
        <div class="kpi-icon-container icon-briefcase">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <span class="flow-badge badge-status-todo">Active</span>
      </div>
      <div>
        <div class="kpi-value-row">
          <span class="kpi-number" id="kpiProjects">0</span>
          <span class="kpi-unit">projects</span>
        </div>
        <div class="kpi-label">In Progress</div>
      </div>
    </div>

    <!-- Tasks Completed -->
    <div class="flow-card kpi-card flow-card-interactive">
      <div class="kpi-header">
        <div class="kpi-icon-container icon-check">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <span class="flow-trend-pill positive" id="kpiTasksToday">+0 today</span>
      </div>
      <div>
        <div class="kpi-value-row">
          <span class="kpi-number" id="kpiTasksCompleted">0</span>
          <span class="kpi-unit">tasks</span>
        </div>
        <div class="kpi-label">Completed This Sprint</div>
      </div>
    </div>

    <!-- Focus Hours -->
    <div class="flow-card kpi-card flow-card-interactive">
      <div class="kpi-header">
        <div class="kpi-icon-container icon-hourglass">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 22h14M5 2h14M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path>
          </svg>
        </div>
        <span class="flow-trend-pill positive" id="kpiGrowth">0.0h</span>
      </div>
      <div>
        <div class="kpi-value-row">
          <span class="kpi-number" id="kpiFocusHours">0.0</span>
          <span class="kpi-unit">h</span>
        </div>
        <div class="kpi-label">Focus Hours Logged</div>
      </div>
    </div>

    <!-- Streak -->
    <div class="flow-card kpi-card flow-card-interactive">
      <div class="kpi-header">
        <div class="kpi-icon-container icon-streak">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
          </svg>
        </div>
        <span class="flow-badge badge-priority-low">Ready</span>
      </div>
      <div>
        <div class="kpi-value-row">
          <span class="kpi-number" id="kpiStreakDays">0</span>
          <span class="kpi-unit">days</span>
        </div>
        <div class="kpi-label">Activity Streak</div>
        <div class="activity-dots-matrix" title="Start a focus session to build your streak!">
          <div class="activity-dot"></div>
          <div class="activity-dot"></div>
          <div class="activity-dot"></div>
          <div class="activity-dot"></div>
          <div class="activity-dot"></div>
          <div class="activity-dot"></div>
          <div class="activity-dot"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Productivity Trends Section -->
  <div class="flow-card trends-card">
    <div class="flow-card-header">
      <div class="flow-card-title-group">
        <h2 class="flow-card-title">Productivity Trends</h2>
        <span class="flow-card-subtitle">Daily focus distribution across the current week</span>
      </div>
      <div class="pill-tab-group">
        <button type="button" class="pill-tab active">This Week</button>
      </div>
    </div>

    <div class="trends-layout">
      <!-- Summary Box -->
      <div class="trends-summary-box">
        <div>
          <span class="trends-big-number">0.0<small style="font-size: 1.4rem;">h</small></span>
          <div class="trends-subtitle">Logged this week</div>
        </div>
        <div class="flow-trend-pill positive" style="align-self: flex-start;">
          <span>Ready to track</span>
        </div>
        <p style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">
          Start your first focus session today to build momentum and see your weekly trends grow.
        </p>
      </div>

      <!-- Pure CSS Interactive Bar Chart -->
      <div class="chart-container">
        <div class="chart-bars-wrap">
          <div class="bar-column">
            <div class="bar-tooltip">Mon: 0.0 h</div>
            <div class="bar-pill" style="height: 6%;"></div>
            <span class="bar-label">Mon</span>
          </div>
          <div class="bar-column">
            <div class="bar-tooltip">Tue: 0.0 h</div>
            <div class="bar-pill" style="height: 6%;"></div>
            <span class="bar-label">Tue</span>
          </div>
          <div class="bar-column">
            <div class="bar-tooltip">Wed: 0.0 h</div>
            <div class="bar-pill" style="height: 6%;"></div>
            <span class="bar-label">Wed</span>
          </div>
          <div class="bar-column">
            <div class="bar-tooltip">Thu: 0.0 h</div>
            <div class="bar-pill" style="height: 6%;"></div>
            <span class="bar-label">Thu</span>
          </div>
          <div class="bar-column">
            <div class="bar-tooltip">Fri: 0.0 h</div>
            <div class="bar-pill" style="height: 6%;"></div>
            <span class="bar-label">Fri</span>
          </div>
          <div class="bar-column">
            <div class="bar-tooltip">Sat: 0.0 h</div>
            <div class="bar-pill" style="height: 6%;"></div>
            <span class="bar-label">Sat</span>
          </div>
          <div class="bar-column">
            <div class="bar-tooltip">Sun: 0.0 h</div>
            <div class="bar-pill" style="height: 6%;"></div>
            <span class="bar-label">Sun</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Row: Mini Time Tracker + Today's Plan -->
  <div class="dashboard-split-grid">
    <!-- Live Mini Time Tracker Card: Default 25:00 per user request -->
    <div class="mini-tracker-widget">
      <div>
        <div class="mini-tracker-header">
          <span class="tracker-tag">CURRENT SESSION</span>
          <span style="font-size: 0.8rem; color: #94A3B8;">Pomodoro 25m</span>
        </div>
        <div class="mini-timer-display" id="dashTimerDisplay">25:00</div>
        <div class="tracker-task-name">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span id="dashSessionTitle">Deep Work Session</span>
        </div>
      </div>
      <div class="tracker-controls">
        <button type="button" class="btn-tracker-play" id="dashPlayBtn" title="Play / Pause Session">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </button>
        <button type="button" class="btn-tracker-reset" id="dashResetBtn" title="Reset Session">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
        </button>
        <a href="/focus" class="btn-flow btn-flow-ghost btn-flow-sm" style="color: #A5B4FC; margin-left: auto;">
          Expand Room &rarr;
        </a>
      </div>
    </div>

    <!-- Today's Plan: No mock data, clean interactive state -->
    <div class="flow-card">
      <div class="flow-card-header">
        <div class="flow-card-title-group">
          <h3 class="flow-card-title">Today's Focus Plan</h3>
          <span class="flow-card-subtitle">Keep high-priority goals top of mind</span>
        </div>
        <a href="/tasks" class="btn-flow btn-flow-ghost btn-flow-sm">
          View All
        </a>
      </div>

      <div class="today-tasks-list" id="todayTasksContainer">
        <!-- Dynamic tasks from localStorage or clean empty state -->
        <div class="empty-tasks-state" id="emptyTodayTasks" style="text-align: center; padding: 32px 16px; color: var(--text-muted);">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 12px; opacity: 0.5;">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M8 12h8"></path>
            <path d="M12 8v8"></path>
          </svg>
          <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-main); margin-bottom: 4px;">No tasks added yet</div>
          <div style="font-size: 0.82rem; margin-bottom: 16px;">Add a task below to prioritize your focus for today.</div>
          <div style="display: flex; gap: 8px; max-width: 380px; margin: 0 auto;">
            <input type="text" id="quickTaskInput" class="form-input" placeholder="Type a task and press Enter..." style="font-size: 0.85rem;" />
            <button type="button" id="quickTaskAddBtn" class="btn-flow btn-flow-primary btn-flow-sm">Add</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // ==========================================
  // Dashboard Mini Timer (Default 25:00)
  // ==========================================
  let dashSeconds = 25 * 60;
  let dashRunning = false;
  let dashInterval = null;

  const timerDisplay = document.getElementById('dashTimerDisplay');
  const playBtn = document.getElementById('dashPlayBtn');
  const resetBtn = document.getElementById('dashResetBtn');

  function renderDashTimer() {
    if (!timerDisplay) return;
    const m = Math.floor(dashSeconds / 60).toString().padStart(2, '0');
    const s = (dashSeconds % 60).toString().padStart(2, '0');
    timerDisplay.textContent = `${m}:${s}`;
  }

  function toggleDashTimer() {
    dashRunning = !dashRunning;
    if (dashRunning) {
      if (playBtn) {
        playBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>`;
      }
      dashInterval = setInterval(() => {
        if (dashSeconds > 0) {
          dashSeconds--;
          renderDashTimer();
        } else {
          clearInterval(dashInterval);
          dashRunning = false;
          if (playBtn) {
            playBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
          }
        }
      }, 1000);
    } else {
      clearInterval(dashInterval);
      if (playBtn) {
        playBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
      }
    }
  }

  function resetDashTimer() {
    clearInterval(dashInterval);
    dashRunning = false;
    dashSeconds = 25 * 60;
    renderDashTimer();
    if (playBtn) {
      playBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
    }
  }

  playBtn?.addEventListener('click', toggleDashTimer);
  resetBtn?.addEventListener('click', resetDashTimer);

  // Quick Task Add Handler
  const quickTaskInput = document.getElementById('quickTaskInput') as HTMLInputElement | null;
  const quickTaskAddBtn = document.getElementById('quickTaskAddBtn');
  const tasksContainer = document.getElementById('todayTasksContainer');

  function addQuickTask() {
    if (!quickTaskInput || !quickTaskInput.value.trim() || !tasksContainer) return;
    const taskName = quickTaskInput.value.trim();
    quickTaskInput.value = '';

    const emptyState = document.getElementById('emptyTodayTasks');
    if (emptyState) emptyState.style.display = 'none';

    const item = document.createElement('div');
    item.className = 'today-task-item';
    item.innerHTML = `
      <label class="flow-checkbox-wrapper">
        <input type="checkbox" class="flow-checkbox-input" />
        <span class="flow-checkbox-custom"></span>
      </label>
      <div class="today-task-content">
        <div class="today-task-title">${taskName}</div>
        <div class="today-task-meta">
          <span class="flow-badge badge-priority-med">Normal</span>
          <span>Today</span>
        </div>
      </div>
    `;

    const checkbox = item.querySelector('input[type="checkbox"]');
    checkbox?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.checked) {
        item.classList.add('completed');
      } else {
        item.classList.remove('completed');
      }
    });

    tasksContainer.prepend(item);
  }

  quickTaskAddBtn?.addEventListener('click', addQuickTask);
  quickTaskInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      addQuickTask();
    }
  });
</script>
